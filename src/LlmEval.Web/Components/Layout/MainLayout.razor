@inherits LayoutComponentBase
@implements IDisposable
@inject CurrentUser Me
@inject EvalService Svc
@inject Toaster Toasts
@inject NavigationManager Nav

<div class="aurora"><span></span></div>
<div class="grain"></div>

<div class="shell">
    <aside class="sidebar">
        <a class="brand" href="">
            <span class="brand-logo"><Icon Name="sparkles" Size="18" /></span>
            <span>
                <div class="brand-name">LLM Eval</div>
                <div class="brand-sub">@L["layout.brandSub"]</div>
            </span>
        </a>
        <nav class="nav">
            <div class="nav-label">@L["layout.nav.evaluation"]</div>
            <NavLink href="" Match="NavLinkMatch.All"><Icon Name="dashboard" /> @L["layout.nav.dashboard"]</NavLink>
            <NavLink href="test-cases"><Icon Name="flask" /> @L["layout.nav.testCases"]</NavLink>
            <NavLink href="batches"><Icon Name="list-checks" /> @L["layout.nav.batches"]</NavLink>
            <NavLink href="iterations"><Icon Name="layers" /> @L["layout.nav.iterations"]</NavLink>
            <div class="nav-label">@L["layout.nav.config"]</div>
            <NavLink href="providers"><Icon Name="cpu" /> @L["layout.nav.providers"]</NavLink>
            <NavLink href="users"><Icon Name="users" /> @L["layout.nav.users"]</NavLink>
            <NavLink href="api-info"><Icon Name="code" /> @L["layout.nav.api"]</NavLink>
        </nav>
        <div class="sidebar-foot">
            <div class="card" style="padding:14px">
                <div class="row small muted"><Icon Name="eye-off" Size="14" /> @L["layout.blindTitle"]</div>
                <div class="small faint" style="margin-top:4px">@((MarkupString)L["layout.blindHint"])</div>
            </div>
        </div>
    </aside>

    <div class="main">
        <header class="topbar">
            <div class="spacer"></div>

            <div class="seg lang-switch" title="@L["lang.label"]">
                @foreach (var lang in I18n.Languages)
                {
                    <button class="@(L.Lang == lang ? "on" : "")" @onclick="() => SwitchLang(lang)">@lang.ToUpperInvariant()</button>
                }
            </div>

            <div class="dropdown">
                <button class="btn btn-ghost btn-icon" title="@L["layout.theme"]" @onclick="() => _themeOpen = !_themeOpen"><Icon Name="palette" /></button>
                @if (_themeOpen)
                {
                    <div class="click-catcher" @onclick="() => _themeOpen = false"></div>
                    <div class="dropdown-menu" style="min-width:200px">
                        @foreach (var t in CurrentUser.Themes)
                        {
                            <button class="dropdown-item @(Me.Theme == t.Id ? "on" : "")" @onclick="() => PickTheme(t.Id)">
                                <span class="theme-dot" style="background:@t.Swatch"></span>
                                <span class="grow">@t.Name</span>
                                @if (Me.Theme == t.Id) { <Icon Name="check" Size="14" /> }
                            </button>
                        }
                    </div>
                }
            </div>

            @if (Me.User is { } u)
            {
                <div class="dropdown">
                    <button class="btn btn-ghost" style="padding-left:6px" @onclick="ToggleUserMenu">
                        <Avatar Name="@u.Name" Hue="u.AvatarHue" IsBot="u.IsBot" Size="26" />
                        <span>@u.Name</span>
                        <Icon Name="chevron-down" Size="14" />
                    </button>
                    @if (_userOpen)
                    {
                        <div class="click-catcher" @onclick="() => _userOpen = false"></div>
                        <div class="dropdown-menu">
                            <div class="small faint" style="padding:6px 10px">@L["layout.switchUser"]</div>
                            @foreach (var other in _users.Where(x => !x.IsAiJudge))
                            {
                                <button class="dropdown-item @(other.Id == u.Id ? "on" : "")" @onclick="() => Pick(other)">
                                    <Avatar Name="@other.Name" Hue="other.AvatarHue" IsBot="other.IsBot" Size="22" />
                                    <span class="grow ellipsis">@other.Name</span>
                                    @if (other.Id == u.Id) { <Icon Name="check" Size="14" /> }
                                </button>
                            }
                            <div class="dropdown-sep"></div>
                            <button class="dropdown-item" @onclick='() => { _userOpen = false; Nav.NavigateTo("users"); }'><Icon Name="users" /> @L["layout.manageUsers"]</button>
                            <button class="dropdown-item" @onclick="Logout"><Icon Name="logout" /> @L["layout.logout"]</button>
                        </div>
                    }
                </div>
            }
        </header>

        <main class="content">
            @if (Me.Loaded)
            {
                @Body
            }
        </main>
    </div>
</div>

@if (Me.Loaded && Me.User is null)
{
    <div class="splash">
        <div class="splash-card">
            <span class="brand-logo" style="width:64px;height:64px;border-radius:18px;margin:0 auto"><Icon Name="sparkles" Size="30" /></span>
            <h1 class="gradient-text">@L["layout.splash.title"]</h1>
            <div class="muted">@L["layout.splash.subtitle"]</div>

            <div class="user-grid">
                @foreach (var cand in _users.Where(x => !x.IsAiJudge))
                {
                    <div class="card card-hover user-tile" @onclick="() => Pick(cand)">
                        <Avatar Name="@cand.Name" Hue="cand.AvatarHue" IsBot="cand.IsBot" Size="52" />
                        <div style="font-weight:600">@cand.Name</div>
                        <div class="small faint ellipsis" style="max-width:100%">@(cand.IsBot ? L["layout.splash.bot"] : cand.Email ?? L["layout.splash.human"])</div>
                    </div>
                }
            </div>

            <div class="row" style="margin-top:22px">
                <input class="input grow" placeholder="@L["layout.splash.addPlaceholder"]" @bind="_newName" @bind:event="oninput"
                       @onkeydown="@(async e => { if (e.Key == "Enter") await CreateAndPick(); })" />
                <button class="btn btn-primary" disabled="@string.IsNullOrWhiteSpace(_newName)" @onclick="CreateAndPick"><Icon Name="plus" /> @L["common.add"]</button>
            </div>
        </div>
    </div>
}

<div class="toast-host">
    @foreach (var t in Toasts.Items)
    {
        <div class="toast @(t.IsError ? "err" : "ok")" @onclick="() => Toasts.Dismiss(t.Id)">
            <Icon Name="@(t.IsError ? "alert" : "check")" Size="18" />
            <div class="grow">@t.Message</div>
        </div>
    }
</div>

<div id="blazor-error-ui" data-nosnippet>
    @L["layout.error.unhandled"]
    <a href="." class="reload">@L["layout.error.reload"]</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private List<UserDto> _users = [];
    private bool _userOpen, _themeOpen;
    private string? _newName;

    protected override async Task OnInitializedAsync()
    {
        Me.Changed += OnChanged;
        Toasts.Changed += OnChanged;
        _users = await Svc.GetUsersAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await L.InitAsync();
            await Me.InitAsync();
        }
    }

    private async Task ToggleUserMenu()
    {
        _userOpen = !_userOpen;
        if (_userOpen) _users = await Svc.GetUsersAsync();
    }

    private async Task Pick(UserDto u)
    {
        _userOpen = false;
        await Me.SetUserAsync(u);
        Toasts.Ok(L["layout.hello", u.Name]);
    }

    private async Task Logout()
    {
        _userOpen = false;
        _users = await Svc.GetUsersAsync();
        await Me.SetUserAsync(null);
    }

    private async Task PickTheme(string id)
    {
        _themeOpen = false;
        await Me.SetThemeAsync(id);
    }

    private async Task CreateAndPick()
    {
        if (string.IsNullOrWhiteSpace(_newName)) return;
        UserDto? created = null;
        if (await Toasts.Try(async () => created = await Svc.CreateUserAsync(new UpsertUserRequest(_newName))))
        {
            _newName = null;
            _users = await Svc.GetUsersAsync();
            await Pick(created!);
        }
    }

    private async Task SwitchLang(string lang)
    {
        if (lang == L.Lang) return;
        await L.SetAsync(lang);
        Nav.NavigateTo(Nav.Uri, forceLoad: true); // simplest way to re-render every component in the new language
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Me.Changed -= OnChanged;
        Toasts.Changed -= OnChanged;
    }
}
