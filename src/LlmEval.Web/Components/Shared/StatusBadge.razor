@using LlmEval.Web.Data
<span class="badge badge-@Status.ToString().ToLowerInvariant()">
    <span class="dot"></span>
    @(Status switch
    {
        ResultStatus.Pending => L["status.pending"],
        ResultStatus.Running => L["status.running"],
        ResultStatus.Cancelled => L["status.cancelled"],
        ResultStatus.Completed => L["status.completed"],
        _ => L["status.failed"]
    })
</span>

@code {
    [Parameter] public ResultStatus Status { get; set; }
}
