@inject EvalService Svc
@inject Toaster Toasts
@inject CurrentUser Me

<Modal Open="Open" OpenChanged="OpenChanged" Title="@(Existing is null ? L["testcases.editor.newTitle"] : L["testcases.editor.editTitle"])" Icon="flask" Wide>
    <ChildContent>
        <div class="stack" style="gap:16px">
            <div class="field">
                <label>@L["testcases.editor.title"]</label>
                <input class="input" @bind="_title" placeholder="@L["testcases.editor.titlePh"]" />
            </div>
            <div class="field">
                <label>@L["testcases.case.prompt"]</label>
                <textarea class="textarea" rows="4" @bind="_prompt" placeholder="@L["testcases.editor.promptPh"]"></textarea>
                <div class="hint">@L["testcases.editor.dataHint1"] <code class="kbd">{{data}}</code> @L["testcases.editor.dataHint2"] <code class="kbd">&lt;data&gt;</code>.</div>
            </div>
            <div class="field">
                <label>@L["testcases.case.data"]</label>
                <textarea class="textarea mono" rows="10" @bind="_data" placeholder="@L["testcases.editor.dataPh"]"></textarea>
            </div>
            <div class="field">
                <label>@L["testcases.case.expected"] <span class="faint">(@L["common.optional"])</span></label>
                <textarea class="textarea" rows="4" @bind="_expected" placeholder="@L["testcases.editor.expectedPh"]"></textarea>
                <div class="hint"><Icon Name="eye-off" Size="11" /> @((MarkupString)L["testcases.editor.expectedHint"])</div>
            </div>
            <details>
                <summary class="small muted" style="cursor:pointer">@L["testcases.case.systemPrompt"] (@L["common.optional"])</summary>
                <textarea class="textarea" rows="3" style="margin-top:8px" @bind="_system" placeholder="@L["testcases.editor.systemPh"]"></textarea>
            </details>
            <div class="field">
                <label>@L["testcases.editor.tags"]</label>
                <input class="input" @bind="_tags" placeholder="@L["testcases.editor.tagsPh"]" />
            </div>
        </div>
    </ChildContent>
    <Footer>
        <button class="btn btn-ghost" @onclick="() => OpenChanged.InvokeAsync(false)">@L["common.cancel"]</button>
        <button class="btn btn-primary" disabled="@_saving" @onclick="Save"><Icon Name="check" /> @L["common.save"]</button>
    </Footer>
</Modal>

@code {
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }
    [Parameter] public TestCaseDto? Existing { get; set; }
    [Parameter] public EventCallback<TestCaseDto> OnSaved { get; set; }

    private string? _title, _prompt, _data, _system, _tags, _expected;
    private bool _saving, _wasOpen;

    protected override void OnParametersSet()
    {
        if (Open && !_wasOpen)
        {
            _title = Existing?.Title;
            _prompt = Existing?.Prompt;
            _data = Existing?.Data;
            _system = Existing?.SystemPrompt;
            _expected = Existing?.ExpectedAnswer;
            _tags = Existing is null ? null : string.Join(", ", Existing.Tags);
        }
        _wasOpen = Open;
    }

    private async Task Save()
    {
        _saving = true;
        var req = new UpsertTestCaseRequest(_title ?? "", _prompt ?? "", _data, _system,
            (_tags ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList(),
            Me.User?.Id, _expected);
        TestCaseDto? saved = null;
        var ok = await Toasts.Try(async () =>
            saved = Existing is null ? await Svc.CreateTestCaseAsync(req) : await Svc.UpdateTestCaseAsync(Existing.Id, req), L["common.saved"]);
        _saving = false;
        if (ok)
        {
            await OpenChanged.InvokeAsync(false);
            await OnSaved.InvokeAsync(saved!);
        }
    }
}
