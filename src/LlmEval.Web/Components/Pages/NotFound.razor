@page "/not-found"
@layout MainLayout

<div class="empty card" style="margin-top:60px">
    <Icon Name="alert" Size="48" />
    <h2 style="margin-bottom:6px">@L["layout.notFound.title"]</h2>
    <div class="muted">@L["layout.notFound.text"]</div>
    <a class="btn btn-primary" href="" style="margin-top:18px"><Icon Name="arrow-left" /> @L["layout.notFound.back"]</a>
</div>
