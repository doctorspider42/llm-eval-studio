@page "/providers"
@inject EvalService Svc
@inject Toaster Toasts

<PageTitle>Providerzy · LLM Eval</PageTitle>

<div class="page-header">
    <div>
        <h1>Providerzy i modele</h1>
        <div class="subtitle">API OpenAI, Anthropic, Ollama oraz lokalne CLI: Claude Code i Codex.</div>
    </div>
    <div class="actions">
        <button class="btn btn-primary" @onclick="() => OpenProvider(null)"><Icon Name="plus" /> Dodaj providera</button>
    </div>
</div>

@if (_providers is null)
{
    <div class="skeleton"></div>
}
else
{
    <div class="stack" style="gap:16px">
        @foreach (var p in _providers)
        {
            var test = _tests.GetValueOrDefault(p.Id);
            <div class="card fade-in @(p.Enabled ? "" : "provider-off")">
                <div class="row" style="align-items:flex-start;gap:14px">
                    <ProviderIcon Type="p.Type" />
                    <div class="grow" style="min-width:0">
                        <div class="row" style="gap:8px">
                            <h3 style="font-size:17px">@p.Name</h3>
                            <span class="badge badge-provider">@TypeLabel(p.Type)</span>
                        </div>
                        <div class="small faint mono ellipsis" style="margin-top:2px">@Describe(p)</div>
                    </div>
                    <label class="switch small" title="@(p.Enabled ? "Wyłącz providera" : "Włącz providera")">
                        <input type="checkbox" checked="@p.Enabled" @onchange="e => ToggleProvider(p, (bool)e.Value!)" />
                        <span class="track"></span> @(p.Enabled ? "Włączony" : "Wyłączony")
                    </label>
                    <button class="btn btn-sm" disabled="@_testing.Contains(p.Id)" @onclick="() => Test(p)">
                        <Icon Name="@(_testing.Contains(p.Id) ? "loader" : "plug")" Size="14" Class="@(_testing.Contains(p.Id) ? "spin" : null)" /> Test
                    </button>
                    <button class="btn btn-sm btn-icon" title="Edytuj" @onclick="() => OpenProvider(p)"><Icon Name="pencil" Size="14" /></button>
                    <button class="btn btn-sm btn-icon btn-danger" title="Usuń" @onclick="() => DeleteProvider(p)"><Icon Name="trash" Size="14" /></button>
                </div>

                @if (test is not null)
                {
                    <div class="@(test.Ok ? "" : "error-box")" style="margin-top:14px;@(test.Ok ? "padding:12px 14px;border-radius:12px;border:1px solid rgba(52,211,153,.3);background:rgba(52,211,153,.06)" : "")">
                        <div class="row small"><Icon Name="@(test.Ok ? "check" : "alert")" Size="14" /> @test.Message</div>
                        @if (test.Models.Count > 0)
                        {
                            <div class="row wrap" style="gap:6px;margin-top:10px">
                                @foreach (var name in test.Models.Take(60))
                                {
                                    var exists = p.Models.Any(m => m.ModelId == name);
                                    <button class="chip @(exists ? "on" : "")" disabled="@exists" title="@(exists ? "Już dodany" : "Kliknij, żeby dodać")" @onclick="() => QuickAdd(p, name)">
                                        @if (!exists) { <Icon Name="plus" Size="11" /> } @name
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }

                <div class="divider"></div>
                @if (p.Models.Count == 0)
                {
                    <div class="small faint">Brak modeli.</div>
                }
                else
                {
                    <table class="table">
                        <thead><tr><th style="width:60px">Aktywny</th><th>Nazwa</th><th>Model ID</th><th>Temperatura</th><th>Max tokens</th><th style="width:110px" title="Model może oceniać odpowiedzi innych modeli">Sędzia AI</th><th></th></tr></thead>
                        <tbody>
                        @foreach (var m in p.Models)
                        {
                            <tr>
                                <td>
                                    <label class="switch" title="@(m.Enabled ? "Wyłącz model" : "Włącz model")">
                                        <input type="checkbox" checked="@m.Enabled" @onchange="e => PatchModel(m, new PatchModelRequest(Enabled: (bool)e.Value!))" />
                                        <span class="track"></span>
                                    </label>
                                </td>
                                <td style="font-weight:500;@(m.Enabled ? "" : "opacity:.45")">@m.DisplayName</td>
                                <td class="mono small muted">@m.ModelId</td>
                                <td class="muted">@(m.Temperature?.ToString("0.##") ?? "domyślna")</td>
                                <td class="muted">@(m.MaxTokens?.ToString() ?? "domyślne")</td>
                                <td>
                                    <button class="judge-toggle @(m.IsJudge ? "on" : "")" title="@(m.IsJudge ? "Sędzia – kliknij, żeby zdjąć togę" : "Ustaw jako sędziego")"
                                            @onclick="() => PatchModel(m, new PatchModelRequest(IsJudge: !m.IsJudge))">
                                        <Icon Name="scale" Size="14" /> @(m.IsJudge ? "Sędzia" : "—")
                                    </button>
                                </td>
                                <td class="num" style="white-space:nowrap">
                                    <button class="btn btn-ghost btn-sm btn-icon" @onclick="() => OpenModel(p, m)"><Icon Name="pencil" Size="13" /></button>
                                    <button class="btn btn-ghost btn-sm btn-icon btn-danger" @onclick="() => DeleteModel(m)"><Icon Name="trash" Size="13" /></button>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
                <button class="btn btn-ghost btn-sm" style="margin-top:8px" @onclick="() => OpenModel(p, null)"><Icon Name="plus" Size="13" /> Dodaj model</button>
            </div>
        }
    </div>
}

<Modal @bind-Open="_providerOpen" Title="@(_editProvider is null ? "Nowy provider" : "Edytuj providera")" Icon="cpu">
    <ChildContent>
        <div class="stack" style="gap:14px">
            <div class="field"><label>Nazwa</label><input class="input" @bind="_pName" placeholder="np. OpenAI prod" /></div>
            <div class="field">
                <label>Typ</label>
                <select class="select" @bind="_pType">
                    @foreach (var t in Enum.GetValues<ProviderType>()) { <option value="@t">@TypeLabel(t)</option> }
                </select>
            </div>
            @if (_pType is ProviderType.OpenAI or ProviderType.Anthropic or ProviderType.Ollama)
            {
                <div class="field">
                    <label>Base URL</label>
                    <input class="input mono" @bind="_pBaseUrl" placeholder="@DefaultUrl(_pType)" />
                    <div class="hint">Puste = domyślny. Dla OpenAI działa też z dowolnym API kompatybilnym (Azure, OpenRouter, LM Studio…).</div>
                </div>
            }
            @if (_pType is ProviderType.OpenAI or ProviderType.Anthropic)
            {
                <div class="field">
                    <label>Klucz API</label>
                    <input class="input mono" type="password" @bind="_pApiKey" placeholder="@(_editProvider?.HasApiKey == true ? "•••••••• (zostaw puste, żeby nie zmieniać)" : "sk-…  (puste = zmienna środowiskowa)")" />
                    @if (_editProvider?.HasApiKey == true)
                    {
                        <label class="switch small"><input type="checkbox" @bind="_pClearKey" /><span class="track"></span> Usuń zapisany klucz</label>
                    }
                    <div class="hint">Fallback: <code class="kbd">@(_pType == ProviderType.OpenAI ? "OPENAI_API_KEY" : "ANTHROPIC_API_KEY")</code></div>
                </div>
            }
            @if (_pType is ProviderType.ClaudeCli or ProviderType.CodexCli)
            {
                <div class="field">
                    <label>Ścieżka do CLI</label>
                    <input class="input mono" @bind="_pCliPath" placeholder="@(_pType == ProviderType.ClaudeCli ? "claude" : "codex") (z PATH)" />
                </div>
                <div class="field">
                    <label>Dodatkowe argumenty</label>
                    <input class="input mono" @bind="_pExtraArgs" placeholder="@(_pType == ProviderType.ClaudeCli ? "np. --max-turns 1" : "np. -c model_reasoning_effort=high")" />
                </div>
            }
            <div class="field"><label>Timeout (s)</label><input class="input" type="number" @bind="_pTimeout" /></div>
            <label class="switch"><input type="checkbox" @bind="_pEnabled" /><span class="track"></span> Włączony</label>
        </div>
    </ChildContent>
    <Footer>
        <button class="btn btn-ghost" @onclick="() => _providerOpen = false">Anuluj</button>
        <button class="btn btn-primary" @onclick="SaveProvider"><Icon Name="check" /> Zapisz</button>
    </Footer>
</Modal>

<Modal @bind-Open="_modelOpen" Title="@(_editModel is null ? "Nowy model" : "Edytuj model")" Icon="sparkles">
    <ChildContent>
        <div class="stack" style="gap:14px">
            <div class="field"><label>Model ID</label><input class="input mono" @bind="_mId" placeholder="np. gpt-5, claude-sonnet-5-5, llama3.2, sonnet" /></div>
            <div class="field"><label>Nazwa wyświetlana</label><input class="input" @bind="_mName" placeholder="puste = Model ID" /></div>
            <div class="grid grid-2">
                <div class="field"><label>Temperatura</label><input class="input" type="number" step="0.1" @bind="_mTemp" placeholder="domyślna" /></div>
                <div class="field"><label>Max tokens</label><input class="input" type="number" @bind="_mMax" placeholder="domyślne" /></div>
            </div>
            <div class="hint">Temperatura/max tokens są ignorowane przez providery CLI. Niektóre modele reasoning nie przyjmują temperatury – zostaw pustą.</div>
            <label class="switch"><input type="checkbox" @bind="_mEnabled" /><span class="track"></span> Włączony</label>
            <label class="switch"><input type="checkbox" @bind="_mIsJudge" /><span class="track"></span> Sędzia AI – może oceniać odpowiedzi innych modeli</label>
        </div>
    </ChildContent>
    <Footer>
        <button class="btn btn-ghost" @onclick="() => _modelOpen = false">Anuluj</button>
        <button class="btn btn-primary" @onclick="SaveModel"><Icon Name="check" /> Zapisz</button>
    </Footer>
</Modal>

@code {
    private List<ProviderDto>? _providers;
    private readonly Dictionary<Guid, ConnectionTestResult> _tests = [];
    private readonly HashSet<Guid> _testing = [];

    private bool _providerOpen, _modelOpen;
    private ProviderDto? _editProvider;
    private string? _pName, _pBaseUrl, _pApiKey, _pCliPath, _pExtraArgs;
    private ProviderType _pType;
    private int _pTimeout = 300;
    private bool _pEnabled = true, _pClearKey;

    private ProviderDto? _modelProvider;
    private ModelDto? _editModel;
    private string? _mId, _mName;
    private double? _mTemp;
    private int? _mMax;
    private bool _mEnabled = true, _mIsJudge;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load() => _providers = await Svc.GetProvidersAsync();

    private static string TypeLabel(ProviderType t) => t switch
    {
        ProviderType.OpenAI => "OpenAI API",
        ProviderType.Anthropic => "Anthropic API",
        ProviderType.Ollama => "Ollama",
        ProviderType.ClaudeCli => "Claude Code CLI",
        _ => "Codex CLI"
    };

    private static string DefaultUrl(ProviderType t) => t switch
    {
        ProviderType.OpenAI => "https://api.openai.com/v1",
        ProviderType.Anthropic => "https://api.anthropic.com/v1",
        _ => "http://localhost:11434"
    };

    private static string Describe(ProviderDto p) => p.Type switch
    {
        ProviderType.ClaudeCli or ProviderType.CodexCli =>
            $"{p.CliPath ?? (p.Type == ProviderType.ClaudeCli ? "claude" : "codex")} {p.ExtraArgs} · timeout {p.TimeoutSeconds}s",
        _ => $"{p.BaseUrl ?? DefaultUrl(p.Type)}{(p.Type == ProviderType.Ollama ? "" : p.HasApiKey ? " · klucz zapisany" : " · klucz z env")}"
    };

    private void OpenProvider(ProviderDto? p)
    {
        _editProvider = p;
        _pName = p?.Name;
        _pType = p?.Type ?? ProviderType.OpenAI;
        _pBaseUrl = p?.BaseUrl;
        _pApiKey = null;
        _pClearKey = false;
        _pCliPath = p?.CliPath;
        _pExtraArgs = p?.ExtraArgs;
        _pTimeout = p?.TimeoutSeconds ?? 300;
        _pEnabled = p?.Enabled ?? true;
        _providerOpen = true;
    }

    private async Task SaveProvider()
    {
        var key = _pClearKey ? "" : string.IsNullOrWhiteSpace(_pApiKey) ? null : _pApiKey;
        var req = new UpsertProviderRequest(_pName ?? "", _pType, _pBaseUrl, key, _pCliPath, _pExtraArgs, _pTimeout, _pEnabled);
        if (await Toasts.Try(async () =>
            {
                if (_editProvider is null) await Svc.CreateProviderAsync(req);
                else await Svc.UpdateProviderAsync(_editProvider.Id, req);
            }, "Provider zapisany"))
        {
            _providerOpen = false;
            await Load();
        }
    }

    private async Task DeleteProvider(ProviderDto p)
    {
        if (await Toasts.Try(() => Svc.DeleteProviderAsync(p.Id), $"Usunięto {p.Name}")) await Load();
    }

    private async Task Test(ProviderDto p)
    {
        _testing.Add(p.Id);
        _tests[p.Id] = await Svc.TestProviderAsync(p.Id);
        _testing.Remove(p.Id);
    }

    private void OpenModel(ProviderDto p, ModelDto? m)
    {
        _modelProvider = p;
        _editModel = m;
        _mId = m?.ModelId;
        _mName = m?.DisplayName;
        _mTemp = m?.Temperature;
        _mMax = m?.MaxTokens;
        _mEnabled = m?.Enabled ?? true;
        _mIsJudge = m?.IsJudge ?? false;
        _modelOpen = true;
    }

    private async Task SaveModel()
    {
        var req = new UpsertModelRequest(_modelProvider!.Id, _mId ?? "", _mName, _mTemp, _mMax, _mEnabled, _mIsJudge);
        if (await Toasts.Try(async () =>
            {
                if (_editModel is null) await Svc.CreateModelAsync(req);
                else await Svc.UpdateModelAsync(_editModel.Id, req);
            }, "Model zapisany"))
        {
            _modelOpen = false;
            await Load();
        }
    }

    private async Task QuickAdd(ProviderDto p, string modelId)
    {
        if (await Toasts.Try(() => Svc.CreateModelAsync(new UpsertModelRequest(p.Id, modelId)), $"Dodano {modelId}")) await Load();
    }

    private async Task ToggleProvider(ProviderDto p, bool enabled)
    {
        if (await Toasts.Try(() => Svc.PatchProviderAsync(p.Id, new PatchProviderRequest(enabled)), $"{p.Name}: {(enabled ? "włączony" : "wyłączony")}"))
            await Load();
    }

    private async Task PatchModel(ModelDto m, PatchModelRequest req)
    {
        var msg = req.IsJudge switch
        {
            true => $"{m.DisplayName} zakłada togę sędziego ⚖️",
            false => $"{m.DisplayName} nie jest już sędzią",
            _ => $"{m.DisplayName}: {(req.Enabled == true ? "włączony" : "wyłączony")}"
        };
        if (await Toasts.Try(() => Svc.PatchModelAsync(m.Id, req), msg)) await Load();
    }

    private async Task DeleteModel(ModelDto m)
    {
        if (await Toasts.Try(() => Svc.DeleteModelAsync(m.Id), $"Usunięto {m.DisplayName}")) await Load();
    }
}
