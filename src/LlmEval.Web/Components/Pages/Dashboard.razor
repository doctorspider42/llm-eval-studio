@page "/"
@implements IDisposable
@inject EvalService Svc
@inject EvalEvents Events
@inject CurrentUser Me
@inject NavigationManager Nav

<PageTitle>@L["dashboard.title"] · LLM Eval</PageTitle>

<div class="page-header">
    <div>
        <h1>@L["dashboard.greeting"] <span class="gradient-text">@(Me.User?.Name.Split(' ')[0] ?? L["dashboard.stranger"])</span> 👋</h1>
        <div class="subtitle">@L["dashboard.subtitle"]</div>
    </div>
    <div class="actions">
        <a class="btn" href="iterations?unrated=1"><Icon Name="star" /> @L["dashboard.toRate"]</a>
        <a class="btn" href="test-cases"><Icon Name="play" /> @L["dashboard.runIteration"]</a>
        <a class="btn btn-primary" href="batches?new=1"><Icon Name="list-checks" /> @L["dashboard.newBatch"]</a>
    </div>
</div>

@if (_data is null)
{
    <div class="stats">@for (var i = 0; i < 5; i++) { <div class="card stat"><div class="skeleton" style="width:40%;height:28px"></div><div class="skeleton" style="width:60%"></div></div> }</div>
}
else
{
    <div class="stats fade-in">
        <Stat Label="@L["dashboard.stat.testCases"]" Value="@_data.TestCases" IconName="flask" />
        <Stat Label="@L["dashboard.stat.iterations"]" Value="@_data.Iterations" IconName="layers" />
        <Stat Label="@L["dashboard.stat.results"]" Value="@_data.Results" IconName="sparkles" />
        <Stat Label="@L["dashboard.stat.ratings"]" Value="@_data.Ratings" IconName="star" />
        <Stat Label="@L["dashboard.stat.users"]" Value="@_data.Users" IconName="users" />
    </div>

    <div class="grid grid-2 fade-in" style="grid-template-columns: 1.25fr 1fr">
        <div class="card">
            <div class="card-title"><Icon Name="trophy" /> @L["dashboard.leaderboard.title"]</div>
            @if (_data.Leaderboard.Count == 0)
            {
                <div class="empty"><Icon Name="trophy" Size="40" /><div>@L["dashboard.leaderboard.empty"]</div></div>
            }
            else
            {
                <table class="table">
                    <thead><tr><th style="width:40px"></th><th>@L["dashboard.col.model"]</th><th>@L["dashboard.col.avg"]</th><th class="num">@L["dashboard.col.wins"]</th><th class="num">@L["dashboard.col.ratings"]</th><th class="num">@L["dashboard.col.time"]</th></tr></thead>
                    <tbody>
                    @{ var rank = 0; }
                    @foreach (var e in _data.Leaderboard)
                    {
                        rank++;
                        <tr>
                            <td><span class="rank @(e.AvgStars is not null && rank <= 3 ? $"rank-{rank}" : "")">@rank</span></td>
                            <td>
                                <div class="row">
                                    <ProviderIcon Type="e.Model.ProviderType" Size="28" />
                                    <div class="grow">
                                        <div style="font-weight:600">@e.Model.DisplayName</div>
                                        <div class="small faint">@e.Model.ProviderName · @L.Plural("dashboard.runs", e.Runs)@(e.Failures > 0 ? " · " + L.Plural("plural.errors", e.Failures) : "")</div>
                                    </div>
                                </div>
                            </td>
                            <td style="min-width:150px">
                                <div class="row"><span class="score">@L.Stars(e.AvgStars)</span><StarRating Value="e.AvgStars ?? 0" ReadOnly Size="13" /></div>
                                <div class="bar" style="margin-top:6px"><i style="width:@((e.AvgStars ?? 0) / 5 * 100)%"></i></div>
                                @if (e.AvgStarsAi is not null)
                                {
                                    <div class="small faint" style="margin-top:4px">@L["dashboard.humans"] @L.Stars(e.AvgStarsHuman) · AI @L.Stars(e.AvgStarsAi)</div>
                                }
                            </td>
                            <td class="num">@e.Wins</td>
                            <td class="num">@e.RatingCount</td>
                            <td class="num faint">@L.Ms(e.AvgLatencyMs)</td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </div>

        <div class="card">
            <div class="card-title"><Icon Name="clock" /> @L["dashboard.recent.title"]</div>
            @if (_data.Recent.Count == 0)
            {
                <div class="empty"><Icon Name="layers" Size="40" /><div>@L["dashboard.recent.empty"]</div></div>
            }
            else
            {
                <div class="stack" style="gap:4px">
                    @foreach (var it in _data.Recent)
                    {
                        <IterationRow Item="it" />
                    }
                </div>
            }
        </div>
    </div>
}

@code {
    private DashboardDto? _data;

    protected override async Task OnInitializedAsync()
    {
        Events.Changed += OnChanged;
        Me.Changed += OnUserChanged;
        _data = await Svc.GetDashboardAsync();
    }

    private bool _reloadPending;

    // Results stream in fast during a run – coalesce bursts into one reload.
    private void OnChanged()
    {
        if (_reloadPending) return;
        _reloadPending = true;
        _ = InvokeAsync(async () =>
        {
            await Task.Delay(600);
            _reloadPending = false;
            _data = await Svc.GetDashboardAsync();
            StateHasChanged();
        });
    }

    private void OnUserChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Events.Changed -= OnChanged;
        Me.Changed -= OnUserChanged;
    }
}
