@page "/api-info"
@inject NavigationManager Nav
@inject CurrentUser Me
@inject IJSRuntime JS
@inject Toaster Toasts

<PageTitle>API · LLM Eval</PageTitle>

<div class="page-header">
    <div>
        <h1>@L["api.title"]</h1>
        <div class="subtitle">@L["api.subtitle"]</div>
    </div>
    <div class="actions">
        <a class="btn" href="openapi/v1.json" target="_blank"><Icon Name="file" /> OpenAPI JSON</a>
        <a class="btn btn-primary" href="scalar" target="_blank"><Icon Name="external" /> @L["api.docs"]</a>
    </div>
</div>

<div class="grid grid-2" style="align-items:start">
    <div class="card">
        <div class="card-title"><Icon Name="zap" /> @L["api.quickStart"]</div>
        <div class="stack">
            @foreach (var (title, cmd) in Examples)
            {
                <div>
                    <div class="row small muted" style="margin-bottom:6px"><span class="grow">@title</span>
                        <button class="btn btn-ghost btn-sm btn-icon" @onclick="() => Copy(cmd)"><Icon Name="copy" Size="13" /></button>
                    </div>
                    <pre class="pre-block">@cmd</pre>
                </div>
            }
        </div>
    </div>

    <div class="stack" style="gap:16px">
        <div class="card">
            <div class="card-title"><Icon Name="bot" /> @L["api.skill.title"]</div>
            <div class="muted">
                @((MarkupString)L["api.skill.intro"])
            </div>
            <pre class="pre-block" style="margin-top:12px">@L["api.skill.prompt"]</pre>
            <div class="small faint" style="margin-top:10px">@L["api.skill.note"]</div>
        </div>
        <div class="card">
            <div class="card-title"><Icon Name="layers" /> @L["api.resources.title"]</div>
            <table class="table">
                <tbody>
                    <tr><td class="mono small">/api/users</td><td class="muted small">@L["api.resources.users"]</td></tr>
                    <tr><td class="mono small">/api/providers · /api/models</td><td class="muted small">@L["api.resources.providers"]</td></tr>
                    <tr><td class="mono small">/api/test-cases</td><td class="muted small">@L["api.resources.testCases"] <code>POST …/{id}/iterations</code></td></tr>
                    <tr><td class="mono small">/api/iterations/{id}</td><td class="muted small">@L["api.resources.iterations"], <code>?reveal=true</code>, <code>/wait</code></td></tr>
                    <tr><td class="mono small">/api/results/{id}/rating</td><td class="muted small">@L["api.resources.rating"]</td></tr>
                    <tr><td class="mono small">/api/stats/leaderboard</td><td class="muted small">@L["api.resources.leaderboard"]</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private string Base => Nav.BaseUri.TrimEnd('/');
    private string ExampleComment => L["api.ex.comment"];
    private string UserId => Me.User?.Id.ToString() ?? "<USER_ID>";

    private IEnumerable<(string, string)> Examples =>
    [
        (L["api.ex.listCases"], $"curl {Base}/api/test-cases"),
        (L["api.ex.listModels"], $"curl \"{Base}/api/models?onlyEnabled=true\""),
        (L["api.ex.run"], $"curl -X POST {Base}/api/test-cases/<TEST_CASE_ID>/iterations \\\n  -H \"Content-Type: application/json\" \\\n  -d '{{\"modelIds\":[\"<MODEL_ID>\",\"<MODEL_ID>\"],\"userId\":\"{UserId}\"}}'"),
        (L["api.ex.wait"], $"curl \"{Base}/api/iterations/<ITERATION_ID>/wait?timeoutSeconds=180\""),
        (L["api.ex.rate"], $"curl -X PUT {Base}/api/results/<RESULT_ID>/rating \\\n  -H \"Content-Type: application/json\" \\\n  -d '{{\"userId\":\"{UserId}\",\"stars\":4,\"comment\":\"{ExampleComment}\"}}'"),
        (L["api.ex.leaderboard"], $"curl {Base}/api/stats/leaderboard"),
    ];

    private async Task Copy(string text)
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
        Toasts.Ok(L["common.copied"]);
    }
}
