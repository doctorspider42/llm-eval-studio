@page "/batches/{Id:guid}"
@implements IDisposable
@inject EvalService Svc
@inject BatchSummaryService SummarySvc
@inject EvalEvents Events
@inject Toaster Toasts
@inject CurrentUser Me
@inject NavigationManager Nav

<PageTitle>@(_b?.Summary.Name ?? L["batch.detail.fallbackTitle"]) · LLM Eval</PageTitle>

@if (_notFound)
{
    <div class="card empty"><Icon Name="alert" Size="40" /><div>@L["batch.detail.notFound"]</div><a class="btn" href="batches" style="margin-top:12px">@L["common.back"]</a></div>
}
else if (_b is null)
{
    <div class="skeleton" style="width:40%;height:28px"></div><div class="skeleton" style="width:60%"></div>
}
else
{
    var s = _b.Summary;
    var reps = Enumerable.Range(1, s.Repetitions).ToList();

    <div class="crumbs"><a href="batches">@L["batch.list.title"]</a><Icon Name="chevron-right" Size="12" /><span>@s.Name</span></div>
    <div class="page-header">
        <div style="min-width:0">
            <h1>@s.Name</h1>
            <div class="subtitle">
                @L["batch.calcLine", s.TestCaseCount, s.ModelCount, s.Repetitions, s.ResultTotal]
                · @(s.CreatedBy ?? L["common.someone"]) · @L.Date(s.CreatedAt)
            </div>
        </div>
        <div class="actions">
            @if (s.IsRunning)
            {
                <button class="btn btn-danger btn-sm" @onclick="() => StopBatch(false)">@L["iteration.stopGeneration"]</button>
            }
            @if (s.IsJudging || s.AutoJudge)
            {
                <button class="btn btn-danger btn-sm" @onclick="() => StopBatch(true)">@L["iteration.stopJudges"]</button>
            }
            <button class="btn btn-ghost btn-danger btn-icon" title="@L["batch.detail.delete"]" @onclick="() => _confirmDelete = true"><Icon Name="trash" /></button>
            <div class="dropdown">
                <button class="btn" @onclick="() => _reportOpen = !_reportOpen"><Icon Name="file" /> @L["batch.report.button"] <Icon Name="chevron-down" Size="13" /></button>
                @if (_reportOpen)
                {
                    <div class="click-catcher" @onclick="() => _reportOpen = false"></div>
                    <div class="dropdown-menu" style="min-width:300px;padding:10px">
                        <div class="small faint" style="margin-bottom:8px">@L["batch.report.intro"]</div>
                        <div class="stack" style="gap:8px">
                            <label class="switch small"><input type="checkbox" @bind="_repReveal" /><span class="track"></span> @L["batch.report.reveal"]</label>
                            <label class="small">@L["batch.report.descriptions"]</label>
                            <select class="select" @bind="_repCommentMode" aria-label="@L["batch.report.descriptions"]">
                                <option value="details">@L["batch.report.comments"]</option>
                                <option value="summaries">@L["batch.report.summaries"]</option>
                                <option value="none">@L["batch.report.noComments"]</option>
                            </select>
                            @if (_repCommentMode == "summaries")
                            {
                                <select class="select" @bind="_repSummaryId" aria-label="@L["batch.summary.judge"]">
                                    <option value="">@L["batch.summary.latest"]</option>
                                    @foreach (var summary in ReadySummaries) { <option value="@summary.Id">@summary.JudgeName</option> }
                                </select>
                            }
                            <label class="switch small"><input type="checkbox" @bind="_repAnswers" /><span class="track"></span> @L["batch.report.answers"]</label>
                        </div>
                        @if (_repCommentMode != "summaries" || SummaryForReport is not null)
                        {
                        <a class="btn btn-primary btn-sm" style="width:100%;margin-top:12px" href="@ReportUrl(print: true)" target="_blank" @onclick="() => _reportOpen = false">
                            <Icon Name="file" Size="14" /> @L["batch.report.pdf"]
                        </a>
                        <a class="btn btn-ghost btn-sm" style="width:100%;margin-top:4px" href="@ReportUrl(print: false)" target="_blank" @onclick="() => _reportOpen = false">
                            <Icon Name="external" Size="14" /> @L["batch.report.preview"]
                        </a>
                        }
                        else { <div class="hint" style="margin-top:12px">@L["batch.summary.reportNeeded"]</div> }
                    </div>
                }
            </div>
            <button class="btn" disabled="@(Me.User is null)" @onclick="GoNextUnrated" title="@L["batch.detail.nextUnratedTitle"]">
                <Icon Name="star" /> @L["batch.detail.rateInOrder"]
            </button>
            <div class="dropdown">
                <button class="btn" @onclick="OpenJudgeMenu"><Icon Name="scale" /> @L["batch.detail.judgeAll"] <Icon Name="chevron-down" Size="13" /></button>
                @if (_judgeOpen)
                {
                    <div class="click-catcher" @onclick="() => _judgeOpen = false"></div>
                    <div class="dropdown-menu" style="min-width:320px">
                        @if (_judges.Count == 0)
                        {
                            <div style="padding:10px" class="small muted">@((MarkupString)L["batch.detail.noJudges"])</div>
                        }
                        else
                        {
                            <div class="small faint" style="padding:6px 10px">@L["batch.detail.judgesBlind"]</div>
                            @foreach (var j in _judges)
                            {
                                var on = _judgeSel.Contains(j.Id);
                                <button class="dropdown-item @(on ? "on" : "")" @onclick="() => ToggleJudge(j.Id)">
                                    <span class="check" style="@(on ? "background:linear-gradient(135deg,var(--accent),var(--accent-2));border-color:transparent;color:#fff" : "")"><Icon Name="check" Size="12" Stroke="3" /></span>
                                    <ProviderIcon Type="j.ProviderType" Size="20" />
                                    <span class="grow ellipsis">@j.DisplayName</span>
                                </button>
                            }
                            <div class="dropdown-sep"></div>
                            <label class="switch small" style="padding:6px 10px">
                                <input type="checkbox" @bind="_onlyUnjudged" /><span class="track"></span> @L["batch.detail.skipJudged"]
                            </label>
                            <div style="padding:4px">
                                <button class="btn btn-primary btn-sm" style="width:100%" disabled="@(_judgeSel.Count == 0)" @onclick="RunJudges">
                                    <Icon Name="zap" Size="14" /> @L["batch.detail.judgeN", s.IterationCount]
                                </button>
                            </div>
                            @if (s.IsRunning)
                            {
                                <div class="small faint" style="padding:6px 10px">@L["batch.detail.judgeDeferred"]</div>
                            }
                        }
                    </div>
                }
            </div>
            <button class="btn @(_reveal ? "" : "btn-primary")" @onclick="ToggleReveal">
                <Icon Name="@(_reveal ? "eye-off" : "eye")" /> @(_reveal ? L["common.hide"] : L["common.reveal"])
            </button>
        </div>
    </div>

    @* ── progress ── *@
    <div class="grid grid-2" style="margin-bottom:16px">
        <div class="card" style="padding:16px 18px">
            <div class="row small" style="margin-bottom:8px">
                <Icon Name="sparkles" Size="14" /> <b class="grow">@L["batch.detail.answers"]</b>
                <span class="mono">@s.ResultDone / @s.ResultTotal</span>
                @if (s.ResultFailed > 0) { <span class="badge badge-failed">@s.ResultFailed ✕</span> }
            </div>
            <div class="progress" style="height:6px"><i style="width:@(s.ResultDone * 100 / Math.Max(1, s.ResultTotal))%"></i></div>
            <div class="small faint" style="margin-top:6px">@(s.IsRunning ? L["batch.detail.generating"] : L["batch.detail.allGenerated"])</div>
        </div>
        <div class="card" style="padding:16px 18px">
            <div class="row small" style="margin-bottom:8px">
                <Icon Name="scale" Size="14" /> <b class="grow">@L["batch.detail.judge"]</b>
                <span class="mono">@s.JudgeDone / @s.JudgeTotal</span>
                <label class="switch small" title="@L["batch.detail.autoTitle"]">
                    <input type="checkbox" checked="@s.AutoJudge" @onchange="e => SetAuto((bool)e.Value!)" /><span class="track"></span> @L["batch.badge.auto"]
                </label>
            </div>
            <div class="progress" style="height:6px"><i style="width:@(s.JudgeDone * 100 / Math.Max(1, s.JudgeTotal))%;background:linear-gradient(90deg,#f59e0b,#fde68a)"></i></div>
            <div class="small faint" style="margin-top:6px">
                @(s.JudgeTotal == 0 ? (s.AutoJudge ? L["batch.detail.judgeWaiting"] : L["batch.detail.judgeNone"]) : s.IsJudging ? L["batch.detail.judging"] : L["batch.detail.judgeDone"])
            </div>
        </div>
    </div>

    <div class="card stack" style="margin-bottom:16px;gap:12px">
        <div class="card-title"><Icon Name="sparkles" /> @L["batch.summary.title"]</div>
        <div class="small muted">@L["batch.summary.intro"]</div>
        <div class="row wrap">
            <select class="select" style="width:260px;max-width:100%" @bind="_summaryJudgeId" aria-label="@L["batch.summary.judge"]">
                <option value="">@L["batch.summary.chooseJudge"]</option>
                @foreach (var judge in _judges) { <option value="@judge.Id">@judge.DisplayName</option> }
            </select>
            <button class="btn" disabled="@(_summaryJudgeId is null || s.IsRunning || s.IsJudging || _summarySubmitting || SummaryBusy)" @onclick="GenerateSummary">
                <Icon Name="sparkles" Size="14" /> @L["batch.summary.generate"]
            </button>
            @if (s.IsRunning || s.IsJudging) { <span class="small faint">@L["batch.summary.wait"]</span> }
            @if (_judges.Count == 0) { <span class="small faint">@L["batch.summary.noJudges"]</span> }
        </div>
        @foreach (var summary in _summaries.Where(r => r.Language == L.Lang))
        {
            <details class="card" style="padding:12px" open="@(summary.Status != ResultStatus.Completed || summary.IsStale)">
                <summary style="cursor:pointer">
                    <b>@summary.JudgeName</b> · @L.Date(summary.CreatedAt)
                    @if (summary.Status is ResultStatus.Pending or ResultStatus.Running) { <span class="muted"> · @L["batch.summary.progress", summary.CompletedCases, summary.TotalCases]</span> }
                    @if (summary.Status == ResultStatus.Failed) { <span class="badge badge-failed">@L["batch.summary.failed"]</span> }
                    @if (summary.IsStale) { <span class="badge">@L["batch.summary.stale"]</span> }
                </summary>
                @if (summary.Error is not null) { <p class="small muted">@summary.Error</p> }
                @if (summary.IsStale) { <p class="small muted">@L["batch.summary.staleHint"]</p> }
                @if (summary.Status == ResultStatus.Completed)
                {
                    <p style="white-space:pre-wrap">@summary.Overview</p>
                    @foreach (var item in summary.Cases)
                    {
                        <div class="divider"></div>
                        <h3>@(_b.Rows.FirstOrDefault(r => r.TestCaseId == item.TestCaseId)?.Title)</h3>
                        <div class="small faint">@L["batch.summary.repetitions", item.Repetitions]</div>
                        <p style="white-space:pre-wrap">@item.Text</p>
                        @foreach (var model in item.Models)
                        {
                            <p style="white-space:pre-wrap"><b>@(NameOf(model.Alias) ?? L["candidate", model.Alias]):</b> @model.Text</p>
                        }
                    }
                }
            </details>
        }
    </div>

    @* ── per-model standings ── *@
    <div class="card" style="margin-bottom:16px">
        <div class="card-title"><Icon Name="trophy" /> @L["batch.detail.standings"]
            <span class="grow"></span>
            @if (!_reveal) { <span class="small faint" style="text-transform:none;letter-spacing:0;font-weight:400">@L["batch.detail.aliasHint"]</span> }
        </div>
        <table class="table">
            <thead><tr>
                <th style="width:40px"></th><th>@L["batch.col.model"]</th><th>@L["batch.col.avg"]</th><th class="num">@L["batch.col.humans"]</th><th class="num">@L["batch.col.ai"]</th>
                <th class="num" title="@L["batch.col.winsTitle"]">@L["batch.col.wins"]</th>
                <th class="num" title="@L["batch.col.spreadTitle"]">@L["batch.col.spread"]</th>
                <th class="num">@L["batch.col.errors"]</th><th class="num">@L["batch.col.avgTime"]</th><th class="num">@L["batch.col.avgTokens"]</th>
            </tr></thead>
            <tbody>
            @{ var rank = 0; }
            @foreach (var m in _b.Models.OrderByDescending(m => m.AvgStars ?? -1).ThenByDescending(m => m.Wins))
            {
                rank++;
                <tr>
                    <td><span class="rank @(m.AvgStars is not null && rank <= 3 ? $"rank-{rank}" : "")">@rank</span></td>
                    <td>
                        @if (m.Model is { } mr)
                        {
                            <div class="row reveal-name"><ProviderIcon Type="mr.ProviderType" Size="26" />
                                <div><div style="font-weight:600">@mr.DisplayName</div><div class="small faint">@L["candidate", m.Alias] · @mr.ProviderName</div></div>
                            </div>
                        }
                        else
                        {
                            <div class="row"><span class="slot" style="--h:@CandidateChip.Hue(m.Alias);width:26px;height:26px;font-size:12px;border-radius:8px">@CandidateChip.Letter(m.Alias)</span>
                                <div style="font-weight:600">@L["candidate", m.Alias]</div></div>
                        }
                    </td>
                    <td style="min-width:150px">
                        <div class="row"><span class="score">@L.Stars(m.AvgStars)</span><StarRating Value="m.AvgStars ?? 0" ReadOnly Size="13" /></div>
                        <div class="small faint">@L.Plural("plural.ratings", m.RatingCount)</div>
                    </td>
                    <td class="num">@L.Stars(m.AvgStarsHuman)</td>
                    <td class="num">@L.Stars(m.AvgStarsAi)</td>
                    <td class="num">@m.Wins</td>
                    <td class="num">@(m.StdDev is { } sd ? L.Num(sd, "0.00") : "—")</td>
                    <td class="num" style="@(m.Failures > 0 ? "color:var(--err)" : "")">@m.Failures/@m.Results</td>
                    <td class="num faint">@L.Ms(m.AvgLatencyMs)</td>
                    <td class="num faint">@(m.AvgOutputTokens is { } tok ? L.Num(tok) : "—")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    @* ── matrix ── *@
    <div class="card">
        <div class="card-title"><Icon Name="grid" /> @L["batch.matrix.title"]
            <span class="grow"></span>
            <span class="row small faint" style="text-transform:none;letter-spacing:0;font-weight:400;gap:12px">
                <span>@L["batch.matrix.legend"]</span>
                <span class="cm" style="opacity:.6"><b>·</b>@L["batch.matrix.pending"]</span>
                <span class="cm fail"><b>A</b>✕</span><span style="margin-left:-6px">@L["batch.matrix.failed"]</span>
                <span><Icon Name="scale" Size="11" /> @L["batch.matrix.judge"]</span>
                <span style="color:var(--ok)">✓ @L["batch.matrix.ratedByMe"]</span>
            </span>
        </div>
        <div style="overflow-x:auto">
            <table class="matrix">
                <thead><tr>
                    <th class="tc">@L["batch.matrix.case"]</th>
                    @foreach (var r in reps) { <th>@L["batch.matrix.rep", r]</th> }
                    <th>@L["batch.matrix.rowAvg"]</th>
                </tr></thead>
                <tbody>
                @foreach (var row in _b.Rows)
                {
                    <tr>
                        <td class="tc"><a href="test-cases/@row.TestCaseId" class="ellipsis" style="display:block;font-weight:500" title="@row.Title">@row.Title</a></td>
                        @foreach (var r in reps)
                        {
                            var c = row.Cells.FirstOrDefault(x => x.Repetition == r);
                            <td>
                                @if (c is not null)
                                {
                                    <a class="cell @(c.RatedByMe ? "mine" : "")" href="iterations/@c.IterationId" title="@L["batch.matrix.cellTitle", c.Number]">
                                        <span class="cms">
                                            @foreach (var m in c.Models)
                                            {
                                                <CandidateChip Alias="@m.Alias" Avg="m.AvgStars" Status="m.Status" RatingCount="m.RatingCount" Name="@NameOf(m.Alias)" />
                                            }
                                        </span>
                                        @if (c.JudgeTotal > 0)
                                        {
                                            <span class="judge-mark" title="@L["batch.matrix.judgeTitle", c.JudgeDone, c.JudgeTotal]"><Icon Name="scale" Size="11" Class="@(c.JudgeDone < c.JudgeTotal ? "spin-slow" : null)" /></span>
                                        }
                                    </a>
                                }
                            </td>
                        }
                        <td>
                            <span class="cms" style="justify-content:center">
                                @foreach (var m in row.ModelAvgs)
                                {
                                    <CandidateChip Alias="@m.Alias" Avg="m.AvgStars" Status="ResultStatus.Completed" Name="@NameOf(m.Alias)" />
                                }
                            </span>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    <Modal @bind-Open="_confirmDelete" Title="@L["batch.detail.deleteConfirm"]" Icon="trash">
        <ChildContent><div class="muted">@L["batch.detail.deleteBody", s.IterationCount]</div></ChildContent>
        <Footer>
            <button class="btn btn-ghost" @onclick="() => _confirmDelete = false">@L["common.cancel"]</button>
            <button class="btn btn-danger" @onclick="Delete"><Icon Name="trash" /> @L["batch.detail.delete"]</button>
        </Footer>
    </Modal>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private async Task StopBatch(bool judges) => await Toasts.Try(() => Svc.CancelBatchAsync(Id, judges));

    private BatchDto? _b;
    private bool _notFound, _reveal, _judgeOpen, _onlyUnjudged = true, _confirmDelete;
    private List<ModelDto> _judges = [];
    private readonly HashSet<Guid> _judgeSel = [];
    private List<AiBatchSummaryDto> _summaries = [];
    private Guid? _summaryJudgeId, _repSummaryId;
    private bool _summarySubmitting;
    private IEnumerable<AiBatchSummaryDto> ReadySummaries => _summaries.Where(r => r.Language == L.Lang && r.Status == ResultStatus.Completed && !r.IsStale);
    private AiBatchSummaryDto? SummaryForReport => ReadySummaries.FirstOrDefault(r => _repSummaryId is null || r.Id == _repSummaryId);
    private bool SummaryBusy => _summaries.Any(r => r.JudgeModelId == _summaryJudgeId && r.Language == L.Lang && r.Status is ResultStatus.Pending or ResultStatus.Running);

    protected override async Task OnParametersSetAsync()
    {
        Events.Changed -= OnChanged;
        Events.Changed += OnChanged;
        Me.Changed -= OnUserChanged;
        Me.Changed += OnUserChanged;
        await Load();
    }

    private async Task Load()
    {
        try
        {
            _b = await Svc.GetBatchAsync(Id, _reveal, Me.User?.Id);
            _summaries = await SummarySvc.GetAsync(Id);
            _judges = await Svc.GetJudgeModelsAsync();
            _summaryJudgeId ??= _judges.FirstOrDefault()?.Id;
            _notFound = false;
        }
        catch (EvalException) { _notFound = true; }
    }

    /// <summary>Real model name for an alias – only when revealed.</summary>
    private string? NameOf(string alias) => _b?.Models.FirstOrDefault(m => m.Alias == alias)?.Model?.DisplayName;


    private bool _reportOpen, _repReveal = true, _repAnswers;
    private string _repCommentMode = "details";

    private string ReportUrl(bool print) =>
        $"reports/batches/{Id}?lang={L.Lang}&reveal={_repReveal.ToString().ToLowerInvariant()}" +
        $"&comments={(_repCommentMode == "details").ToString().ToLowerInvariant()}&summaries={(_repCommentMode == "summaries").ToString().ToLowerInvariant()}" +
        $"&summaryId={SummaryForReport?.Id}&answers={_repAnswers.ToString().ToLowerInvariant()}&print={print.ToString().ToLowerInvariant()}";

    private async Task GenerateSummary()
    {
        if (_summaryJudgeId is not { } judge) return;
        _summarySubmitting = true;
        await Toasts.Try(async () => { await SummarySvc.GenerateAsync(Id, new(judge, L.Lang, Regenerate: true)); }, L["batch.summary.queued"]);
        _summarySubmitting = false;
        await Load();
    }

    private async Task ToggleReveal()
    {
        _reveal = !_reveal;
        await Load();
    }

    private async Task OpenJudgeMenu()
    {
        _judgeOpen = !_judgeOpen;
        if (!_judgeOpen) return;
        _judges = await Svc.GetJudgeModelsAsync();
        _judgeSel.RemoveWhere(id => _judges.All(j => j.Id != id));
        if (_judgeSel.Count == 0) foreach (var j in _judges) _judgeSel.Add(j.Id);
    }

    private void ToggleJudge(Guid id)
    {
        if (!_judgeSel.Remove(id)) _judgeSel.Add(id);
    }

    private async Task RunJudges()
    {
        _judgeOpen = false;
        BatchJudgeResult? res = null;
        if (!await Toasts.Try(async () => res = await Svc.JudgeBatchAsync(Id, new JudgeBatchRequest(_judgeSel.ToList(), _onlyUnjudged, Me.User?.Id))))
            return;
        var msg = res!.QueuedRuns == 0 && res.Deferred == 0
            ? L["batch.detail.nothingToJudge"]
            : L["batch.detail.judgeQueued", res.QueuedRuns] + (res.Deferred > 0 ? L["batch.detail.judgeQueuedDeferred", res.Deferred] : "");
        Toasts.Ok(msg);
        await Load();
    }

    private async Task SetAuto(bool enabled)
    {
        if (enabled && (await Svc.GetJudgeModelsAsync()).Count == 0 && (_b?.JudgeModelIds.Count ?? 0) == 0)
        {
            Toasts.Error(L["batch.noJudges"]);
            await Load();
            return;
        }
        await Toasts.Try(() => Svc.SetBatchAutoJudgeAsync(Id, enabled), enabled ? L["batch.detail.autoOn"] : L["batch.detail.autoOff"]);
        await Load();
    }

    private async Task GoNextUnrated()
    {
        var next = await Svc.NextUnratedInBatchAsync(Id, Me.User!.Id);
        if (next is { } it) Nav.NavigateTo($"iterations/{it}");
        else Toasts.Ok(L["batch.detail.allRated"]);
    }

    private async Task Delete()
    {
        if (await Toasts.Try(() => Svc.DeleteBatchAsync(Id), L["batch.detail.deleted"])) Nav.NavigateTo("batches");
    }

    private bool _reloadPending;

    private void OnChanged()
    {
        if (_reloadPending) return;
        _reloadPending = true;
        _ = InvokeAsync(async () =>
        {
            await Task.Delay(800);
            _reloadPending = false;
            await Load();
            StateHasChanged();
        });
    }

    private void OnUserChanged() => InvokeAsync(async () => { await Load(); StateHasChanged(); });

    public void Dispose()
    {
        Events.Changed -= OnChanged;
        Me.Changed -= OnUserChanged;
    }
}
