@page "/batches"
@implements IDisposable
@inject EvalService Svc
@inject EvalEvents Events
@inject NavigationManager Nav

<PageTitle>Serie · LLM Eval</PageTitle>

<div class="page-header">
    <div>
        <h1>Serie</h1>
        <div class="subtitle">Wiele przypadków × wiele modeli × N powtórzeń – odpalone, ocenione i podsumowane jako całość.</div>
    </div>
    <div class="actions">
        <button class="btn btn-primary" @onclick="() => _dialogOpen = true"><Icon Name="plus" /> Nowa seria</button>
    </div>
</div>

@if (_items is null)
{
    <div class="skeleton"></div><div class="skeleton"></div>
}
else if (_items.Count == 0)
{
    <div class="card empty">
        <Icon Name="list-checks" Size="44" />
        <div>Nie ma jeszcze żadnej serii.</div>
        <div class="small faint" style="margin-top:4px">Zaznacz kilka przypadków na liście albo kliknij „Nowa seria”.</div>
        <button class="btn btn-primary" style="margin-top:16px" @onclick="() => _dialogOpen = true"><Icon Name="zap" /> Odpal pierwszą serię</button>
    </div>
}
else
{
    <div class="stack" style="gap:12px">
        @foreach (var b in _items)
        {
            <a class="card card-hover fade-in" href="batches/@b.Id" style="display:block">
                <div class="row" style="gap:16px">
                    <span class="provider-icon" style="background:linear-gradient(135deg,var(--accent),var(--accent-2))"><Icon Name="list-checks" Size="18" /></span>
                    <div class="grow" style="min-width:0">
                        <div class="row" style="gap:8px">
                            <h3 style="font-size:16px" class="ellipsis">@b.Name</h3>
                            @if (b.IsRunning) { <span class="badge badge-running"><span class="dot"></span>generuje</span> }
                            else if (b.IsJudging) { <span class="badge badge-ai"><Icon Name="scale" Size="11" /> sędzia ocenia</span> }
                            else { <span class="badge badge-completed">gotowa</span> }
                            @if (b.AutoJudge) { <span class="badge badge-provider" title="Iteracje są oceniane przez AI automatycznie"><Icon Name="scale" Size="11" /> auto</span> }
                        </div>
                        <div class="small faint" style="margin-top:2px">
                            @b.TestCaseCount przypadków × @b.ModelCount modeli × @b.Repetitions powt. = @b.ResultTotal odpowiedzi
                            · @(b.CreatedBy ?? "ktoś") · @Fmt.Ago(b.CreatedAt)
                        </div>
                        <div class="row" style="margin-top:10px;gap:14px">
                            <div class="grow">
                                <div class="progress"><i style="width:@(b.ResultDone * 100 / Math.Max(1, b.ResultTotal))%"></i></div>
                                <div class="small faint" style="margin-top:4px">odpowiedzi @b.ResultDone/@b.ResultTotal@(b.ResultFailed > 0 ? $" · {b.ResultFailed} błędów" : "")</div>
                            </div>
                            @if (b.JudgeTotal > 0)
                            {
                                <div class="grow">
                                    <div class="progress"><i style="width:@(b.JudgeDone * 100 / Math.Max(1, b.JudgeTotal))%;background:linear-gradient(90deg,#f59e0b,#fde68a)"></i></div>
                                    <div class="small faint" style="margin-top:4px">sędzia AI @b.JudgeDone/@b.JudgeTotal</div>
                                </div>
                            }
                        </div>
                    </div>
                    <div style="text-align:right;min-width:80px">
                        <div class="score" style="font-size:20px">@Fmt.Stars(b.AvgStars) <Icon Name="star" Size="15" Filled Stroke="0" Class="star-ico" /></div>
                        <div class="small faint">średnio</div>
                    </div>
                </div>
            </a>
        }
    </div>
}

<BatchDialog @bind-Open="_dialogOpen" OnStarted='b => Nav.NavigateTo($"batches/{b.Summary.Id}")' />

@code {
    [SupplyParameterFromQuery(Name = "new")] public int? NewQuery { get; set; }

    private List<BatchSummaryDto>? _items;
    private bool _dialogOpen;

    protected override async Task OnInitializedAsync()
    {
        _dialogOpen = NewQuery == 1;
        Events.Changed += OnChanged;
        _items = await Svc.GetBatchesAsync();
    }

    private bool _reloadPending;

    private void OnChanged()
    {
        if (_reloadPending) return;
        _reloadPending = true;
        _ = InvokeAsync(async () =>
        {
            await Task.Delay(1000);
            _reloadPending = false;
            _items = await Svc.GetBatchesAsync();
            StateHasChanged();
        });
    }

    public void Dispose() => Events.Changed -= OnChanged;
}
